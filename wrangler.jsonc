{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nova-app",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "317595ff-2cf6-481d-a4bc-3a24174ba226","database_name": "nova-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "ceaf75e56ce14c13924c9fd0c0c12305" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
